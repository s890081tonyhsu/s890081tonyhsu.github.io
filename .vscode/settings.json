{
  "editor.tabSize": 2,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "always"
  },
  "eslint.validate": [
    "astro",
    "typescript"
  ],
  "json.schemas": [
    {
      "fileMatch": [
        "**/src/data/links.json"
      ],
      "url": "./.astro/collections/links.schema.json"
    },
    {
      "fileMatch": [
        "**/src/data/experiences.json"
      ],
      "url": "./.astro/collections/experiences.schema.json"
    },
    {
      "fileMatch": [
        "**/src/data/skills.json"
      ],
      "url": "./.astro/collections/skills.schema.json"
    },
    {
      "fileMatch": [
        "**/src/data/languages.json"
      ],
      "url": "./.astro/collections/languages.schema.json"
    },
    {
      "fileMatch": [
        "**/src/data/featured-skills.json"
      ],
      "url": "./.astro/collections/featuredSkills.schema.json"
    }
  ]
}