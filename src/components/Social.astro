---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

const icons: Record<string, { icon: string; title?: string }> = {
  email: { icon: 'lucide:at-sign' },
  facebook: { icon: 'simple-icons:facebook', title: 'Facebook' },
  linkedin: { icon: 'simple-icons:linkedin', title: 'LinkedIn' },
  github: { icon: 'simple-icons:github', title: 'GitHub' },
};

const socials = (await getCollection('links')).filter((link) => link.data.sections.includes('social'));
for (const { id } of socials) {
  if (!icons[id]) throw new Error(`links.json: "${id}" is marked "social" but has no icon in Social.astro`);
}
---

{
  socials.map(({ id, data }) => (
    <a href={data.href} aria-label={id}>
      <Icon name={icons[id].icon} size={48} title={icons[id].title} role={icons[id].title ? 'img' : undefined} />
    </a>
  ))
}
