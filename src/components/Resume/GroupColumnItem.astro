---
import type { CollectionEntry } from 'astro:content';

type Props = {
  item: CollectionEntry<'skills'>['data'];
};

const { item } = Astro.props;
---

<div class="content-item wide">
  <h3>{item.name}</h3>
  <ul>
    {
      item.items.map((subGroup) => (
        <li>
          {subGroup.name}
          {subGroup.items && subGroup.joinable ? (
            <span>: {subGroup.items.join(', ')}</span>
          ) : (
            subGroup.items && (
              <ul>
                {subGroup.items.map((subSubGroup) => (
                  <li>{subSubGroup}</li>
                ))}
              </ul>
            )
          )}
        </li>
      ))
    }
  </ul>
</div>
