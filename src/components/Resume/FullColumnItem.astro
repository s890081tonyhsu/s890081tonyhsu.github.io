---
import { Icon } from 'astro-icon/components';
import ResumeItem from './ResumeItem.astro';
import type { CollectionEntry } from 'astro:content';

type Props = {
  item: CollectionEntry<'experiences'>['data'];
};

const { item } = Astro.props;
---

<ResumeItem wide>
  <h3>
    {item.name}
    {item.suffix && <span class="suffix">as {item.suffix}</span>}
  </h3>
  <p class="description">{item.text}</p>
  {
    item.highlights && (
      <ul class="highlights">
        {item.highlights.map((highlight) => (
          <li>{highlight}</li>
        ))}
      </ul>
    )
  }
  <h4 class="time">
    <Icon name="lucide:calendar" size={32} />{item.time.from} - {item.time.to}
  </h4>
</ResumeItem>
