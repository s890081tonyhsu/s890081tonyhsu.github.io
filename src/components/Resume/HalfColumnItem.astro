---
import ResumeItem from './ResumeItem.astro';

type Props = {
  name: string;
  text: string;
  href?: string;
};

const { name, text, href } = Astro.props;
---

<ResumeItem>
  <h3>{name}</h3>
  <p class="stick">
    {href ? <a href={href}>{text}</a> : text}
  </p>
</ResumeItem>
