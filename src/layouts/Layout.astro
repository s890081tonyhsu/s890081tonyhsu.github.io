---
import BaseHead from '@components/BaseHead.astro';
import Menu from './Menu.vue';

import type { Props as BaseHeadProps } from '@components/BaseHead.astro';

import '@assets/scss/layout.scss';

type Props = BaseHeadProps;

const currentPath = Astro.url.pathname.replace('.html', '');
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...Astro.props} />
    <slot name="head" />
  </head>
  <body>
    <Menu path={currentPath} client:load />
    <div class="container">
      <slot />
    </div>
  </body>
</html>
