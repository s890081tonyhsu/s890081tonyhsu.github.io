---
import BaseHead from '@components/BaseHead.astro';
import Menu from './Menu.astro';

import type { Props as BaseHeadProps } from '@components/BaseHead.astro';

import '@styles/global.css';

type Props = BaseHeadProps;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...Astro.props} />
    <slot name="head" />
  </head>
  <body>
    <Menu />
    <div class="container">
      <slot />
    </div>
  </body>
</html>

<style>
  .container {
    width: 100%;
    min-height: 100vh;
    display: flex;
    justify-content: safe center;
    align-items: center;

    @media (max-width: 959px) {
      padding-inline: 16px;
    }
  }
</style>
