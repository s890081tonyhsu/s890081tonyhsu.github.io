---
import { Icon } from 'astro-icon/components';
import { routePath } from 'src/route-path';

const currentPath = routePath(Astro.url.pathname);
const links = [
  { href: '/', label: 'About me' },
  { href: '/resume', label: 'Resume' },
  { href: '/collections', label: 'Collections' },
];
---

<button
  type="button"
  class="menu-btn"
  aria-label="Toggle navigation"
  aria-controls="nav"
  aria-expanded="false"
>
  <Icon name="lucide:menu" size={28} aria-hidden="true" />
</button>
<nav id="nav" class="hide">
  <h2>
    {
      links.map(({ href, label }, index) => (
        <Fragment>
          {index > 0 && <span>|</span>}
          <a
            class={href === currentPath ? 'active' : undefined}
            aria-current={href === currentPath ? 'page' : undefined}
            href={href}
          >
            {label}
          </a>
        </Fragment>
      ))
    }
  </h2>
</nav>

<script>
  // ClientRouter swaps <body> on navigation, so re-bind after every page load.
  document.addEventListener('astro:page-load', () => {
    const button = document.querySelector<HTMLButtonElement>('.menu-btn');
    const nav = document.getElementById('nav');
    if (!button || !nav) return;

    const toggle = () => {
      const isOpen = nav.classList.toggle('show');
      nav.classList.toggle('hide', !isOpen);
      button.setAttribute('aria-expanded', String(isOpen));
    };

    button.addEventListener('click', toggle);
    nav.addEventListener('click', toggle);
  });
</script>

<style>
  .menu-btn {
    display: none;
    position: fixed;
    top: 0.5em;
    left: 0.5em;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background-color: black;
    color: white;
    cursor: pointer;
    z-index: 100;

    &:focus-visible {
      outline: 2px solid white;
      outline-offset: 2px;
    }

    @media (max-width: 959px) {
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }

  #nav {
    position: fixed;
    bottom: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100px;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0), black 50%);
    z-index: 99;
    pointer-events: none;

    h2 {
      display: flex;
      justify-content: space-around;
      align-items: center;
      pointer-events: auto;

      span {
        font-size: 0.8em;
        margin: 0 20px 0;
      }
    }

    a {
      color: white;
      text-decoration: none;
      display: flex;
      position: relative;

      &:after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 50%;
        width: 0%;
        height: 3px;
        background-color: white;
        transition: all 0.25s ease-in-out;
      }

      &.active:after {
        left: 0%;
        width: 100%;
      }
    }

    /* Mobile: the bar becomes a full-screen overlay toggled by .menu-btn. */
    @media (max-width: 959px) {
      bottom: 0;
      top: 0;
      width: 100%;
      height: 0%;
      opacity: 0;
      visibility: hidden;
      overflow-y: hidden;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(8px);
      flex-direction: column;
      transition:
        opacity 0.5s ease-in-out,
        visibility 0.5s;
      pointer-events: auto;

      &.show {
        height: 100%;
        opacity: 1;
        visibility: visible;
      }

      h2 {
        width: 100%;
        height: auto;
        flex-direction: column;

        a {
          margin: 0.5em 0 0.5em;
        }

        span {
          display: none;
        }
      }
    }
  }
</style>
