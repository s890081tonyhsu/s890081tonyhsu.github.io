---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import FullColumnItem from '@components/Resume/FullColumnItem.astro';
import GroupColumnItem from '@components/Resume/GroupColumnItem.astro';
import HalfColumnItem from '@components/Resume/HalfColumnItem.astro';
import { SITE_DESCRIPTION, SITE_HEAD } from 'src/constants';
import { byOrder, byStartDesc } from 'src/sort';

const headImg = `${SITE_HEAD}?s=200`;
const selfIntroduction = SITE_DESCRIPTION;
const links = (await getCollection('links')).toSorted(byOrder).map(({ data }) => data);
const contacts = links.filter((link) => link.sections.includes('contact'));
const profiles = links.filter((link) => link.sections.includes('profile'));
const experiences = (await getCollection('experiences')).toSorted(byStartDesc).map(({ data }) => data);
const works = experiences.filter((experience) => experience.kind === 'work');
const volunteers = experiences.filter((experience) => experience.kind === 'volunteer');
const educations = experiences.filter((experience) => experience.kind === 'education');
const skills = (await getCollection('skills')).toSorted(byOrder).map(({ data }) => data);
const currentSkills = skills.filter((skill) => skill.era === 'current');
const pastSkills = skills.filter((skill) => skill.era === 'past');
const languages = (await getCollection('languages')).toSorted(byOrder).map(({ data }) => data);
---

<Layout title="Resume">
  <div class="resume-container">
    <div class="resume-header">
      <Image src={headImg} alt="header" width={150} height={150} />
      <h1>
        Hsu, Meng-Chieh<br />
        <span>Frontend Developer</span>
      </h1>
    </div>
    <div class="resume-content">
      <div class="row" style="--i: 1">
        <h2 class="title">About</h2>
        <p class="content-text">{selfIntroduction}</p>
      </div>
      <div class="row" style="--i: 2">
        <h2 class="title">Contact</h2>
        <div class="content-items">
          {contacts.map((contact) => <HalfColumnItem {...contact} />)}
        </div>
      </div>
      <div class="row" style="--i: 3">
        <h2 class="title">Profile</h2>
        <div class="content-items">
          {profiles.map((profile) => <HalfColumnItem {...profile} />)}
        </div>
      </div>
      <div class="row" style="--i: 4">
        <h2 class="title">Works</h2>
        <div class="content-items">
          {
            works.map((work) => (
              <FullColumnItem item={work} />
            ))
          }
        </div>
      </div>
      <div class="row" style="--i: 5">
        <h2 class="title">Skills</h2>
        <div class="content-items">
          {
            currentSkills.map((skill) => (
              <GroupColumnItem item={skill} />
            ))
          }
        </div>
      </div>
      <div class="row" style="--i: 6">
        <h2 class="title">Volunteers</h2>
        <div class="content-items">
          {
            volunteers.map((volunteer) => (
              <FullColumnItem item={volunteer} />
            ))
          }
        </div>
      </div>
      <div class="row" style="--i: 7">
        <h2 class="title">Education</h2>
        <div class="content-items">
          {
            educations.map((education) => (
              <FullColumnItem item={education} />
            ))
          }
        </div>
      </div>
      <div class="row" style="--i: 8">
        <h2 class="title">Past Skills</h2>
        <div class="content-items">
          {
            pastSkills.map((skill) => (
              <GroupColumnItem item={skill} />
            ))
          }
        </div>
      </div>
      <div class="row" style="--i: 9">
        <h2 class="title">Languages</h2>
        <div class="content-items">
          {
            languages.map((language) => (
              <HalfColumnItem {...language} />
            ))
          }
        </div>
      </div>
    </div>
    <div class="blank"></div>
  </div>
</Layout>

<style>
  .resume-container {
    .resume-header {
      display: flex;
      justify-content: center;
      align-items: center;

      img {
        width: 150px;
        margin: 75px;
        border-radius: 100%;
        transition: all var(--duration-fast) var(--ease-pop);
        animation: var(--duration-base) 1 normal scale-in;
        animation-delay: var(--enter-lead);
        animation-fill-mode: backwards;
      }

      h1 {
        width: 500px;
        transition: all var(--duration-fast) var(--ease-pop);
        animation: var(--duration-base) 1 normal slide-in-from-right;
        animation-delay: var(--enter-frame);
        animation-fill-mode: backwards;

        span {
          font-size: 0.65em;
          color: var(--color-fg-muted);
        }
      }
    }

    /* Rows slide in one after another, starting half a beat in; --i (1, 2, ...) is set inline per row. */
    .row {
      display: flex;
      justify-content: center;
      align-content: center;
      margin-bottom: 30px;
      transition: all var(--duration-fast) var(--ease-pop);
      animation: var(--duration-slow) 1 normal slide-in-from-below;
      animation-delay: calc(var(--i) * var(--stagger) + var(--beat) / 2);
      animation-fill-mode: backwards;

      .title {
        width: 300px;
        text-align: right;
        padding-right: 30px;
      }

      .content-text,
      .content-items {
        width: 600px;
        padding: 0 30px 0;
        line-height: 1.5em;
        display: flex;
        flex-wrap: wrap;
      }
    }

    @media (max-width: 959px) {
      padding-top: var(--menu-clearance);
      width: 100%;

      .resume-header {
        flex-direction: column;

        img {
          margin: 0;
        }

        h1 {
          text-align: center;
          width: 100%;
        }
      }

      .resume-content {
        width: 100%;
      }

      .row {
        flex-direction: column;
        width: 100%;
        border-bottom: 1px solid var(--color-border);

        .title {
          width: 100%;
          text-align: left;
          padding-right: 0;
        }

        .content-text,
        .content-items {
          width: 100%;
          padding: 0;
          line-height: 1.5em;
        }
      }
    }
  }
</style>
