---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import Social from '@components/Social.astro';
import { SITE_DESCRIPTION, SITE_HEAD } from 'src/constants';

import '@assets/scss/about.scss';

const headImg = `${SITE_HEAD}?s=200`;
const selfIntroduction = SITE_DESCRIPTION;
const skills = (await getCollection('featuredSkills')).map(({ data }) => data);
const currentWork = (await getCollection('experiences')).find(
  ({ data }) => data.kind === 'work' && data.time.to === 'now',
)?.data;
const profileUrls = (await getCollection('links'))
  .filter(({ data }) => data.sections.includes('social') && data.href?.startsWith('http'))
  .map(({ data }) => data.href);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Meng-Chieh Hsu',
  alternateName: 'otomesound',
  url: Astro.site?.href,
  image: SITE_HEAD,
  description: SITE_DESCRIPTION,
  jobTitle: currentWork?.suffix,
  worksFor: currentWork && { '@type': 'Organization', name: currentWork.name },
  sameAs: profileUrls,
};
---

<Layout>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(personSchema)}
  />
  <div class="home-container">
    <div class="head">
      <Image src={headImg} alt="header" width="200" height="200" />
      <h1>
        Hsu, Meng-Chieh
        <span>@otomesound</span>
      </h1>
      <p>{selfIntroduction}</p>
    </div>
    <div class="bio">
      <h3>Skilled</h3>
      <ul class="skills">
        {
          skills.map(({ name, items }) => (
            <li>
              <b>{name}</b> ({items.join(', ')})
            </li>
          ))
        }
      </ul>
      <h3>Social</h3>
      <div class="socials">
        <Social />
      </div>
    </div>
  </div>
</Layout>
