---
import CollectionRow from '@components/Collection/CollectionRow.astro';
import Layout from '@layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { byOrder } from 'src/sort';

const collections = (await getCollection('collection')).toSorted(byOrder);
---

<Layout
  title="Collections"
  description="Projects I have participated in, with technology tags, screenshots, and source or demo links."
>
  <div class="collection-container">
    <div class="collection-header">
      <h1>Collection</h1>
      <p>
        The following are the projects I have participated. Each project has
        attached technology tags and a screenshot.<br />Some projects can be
        linked to the source code or Demo page.
      </p>
    </div>
    {
      collections.map((collection) => (
        <CollectionRow slug={collection.id} {...collection.data} />
      ))
    }
    <div class="blank"></div>
  </div>
</Layout>

<style>
  .collection-container {
    width: 100%;
    max-width: 960px;
    display: flex;
    flex-direction: column;

    .collection-header {
      margin-bottom: 50px;
      transition: all 0.25s cubic-bezier(1, 0.5, 0.8, 1);
      animation: 0.5s 1 normal slide-in-from-below;
      animation-fill-mode: backwards;

      p {
        line-height: 1.5;
      }
    }

    @media (max-width: 959px) {
      padding-top: 100px;

      .collection-header {
        width: 100%;
      }
    }
  }
</style>
